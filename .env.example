# copy to .env (gitignored). Values below are the defaults, not secrets.
# Settings ignores unrelated keys, so frontend variables can live here too.

# backend, see backend/src/devin_flow/config.py
DATABASE_URL=postgresql+psycopg://devin:devin@localhost:5432/devin_flow
# STATIC_DIR=frontend/dist
# Devin API token is server-side only and optional (routes return 503 without it).
# DEVIN_API_TOKEN=
# HTTPS is required except for localhost loopback stubs.
# DEVIN_API_BASE_URL=https://api.devin.ai/v1
