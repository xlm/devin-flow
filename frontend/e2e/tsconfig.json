{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "@/api/*": ["../src/api/*.d.ts"],
      "@/lib/*": ["../src/lib/*.ts"],
      "@/*": ["../src/*"]
    },
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
